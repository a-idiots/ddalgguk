{
  "name": "ddalgguk-functions",
  "version": "1.0.0",
  "private": true,
  "description": "Server-side purchase verification and entitlement management for 딸꾹",
  "main": "lib/index.js",
  "engines": {
    "node": "22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "build:watch": "tsc -p tsconfig.json --watch",
    "lint": "eslint src --max-warnings=0",
    "test": "npm run build && node --test lib",
    "serve": "npm run build && firebase emulators:start --only functions",
    "shell": "npm run build && firebase functions:shell",
    "logs": "firebase functions:log",
    "certs": "bash tools/fetch-apple-root-certs.sh"
  },
  "dependencies": {
    "@apple/app-store-server-library": "^1.6.0",
    "firebase-admin": "^13.0.2",
    "firebase-functions": "^6.3.0",
    "google-auth-library": "^9.15.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.18.0",
    "@types/express": "^4.17.25",
    "@types/node": "^22.10.0",
    "eslint": "^9.18.0",
    "typescript": "^5.7.0",
    "typescript-eslint": "^8.20.0"
  }
}
